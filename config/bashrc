#!/bin/bash
#############################################
# DOTFILES - Shell Configuration
# Compatible with: bash, zsh
#############################################

# Which shell are we in? Used to pick the right init output below.
if [ -n "$ZSH_VERSION" ]; then
    DOTFILES_SHELL="zsh"
else
    DOTFILES_SHELL="bash"
fi

# SFS paths (shared file system - persists across instances)
# Override SFS_DIR before sourcing this file if your mount point differs.
export SFS_DIR="${SFS_DIR:-/mnt/SFS-Ananth}"
export LOCAL_BIN="$SFS_DIR/local/bin"
export CARGO_HOME="$SFS_DIR/local/cargo"
export RUSTUP_HOME="$SFS_DIR/local/rustup"

# Where this repo lives. Resolved through the ~/.bashrc_dotfiles symlink so it
# works wherever the repo is checked out, not just on the SFS.
if [ -z "$DOTFILES_DIR" ]; then
    _dotfiles_self="${BASH_SOURCE[0]:-$0}"
    _dotfiles_self="$(readlink -f "$_dotfiles_self" 2>/dev/null)"
    if [ -n "$_dotfiles_self" ]; then
        DOTFILES_DIR="$(cd "$(dirname "$_dotfiles_self")/.." && pwd)"
    else
        DOTFILES_DIR="$SFS_DIR/dotfiles"
    fi
    unset _dotfiles_self
fi
export DOTFILES_DIR

#############################################
# PATH
#############################################

# Add SFS-installed tools to PATH
export PATH="$LOCAL_BIN:$CARGO_HOME/bin:$PATH"

# Add local bin
export PATH="$HOME/.local/bin:$PATH"

# Add fzf
export PATH="$HOME/.fzf/bin:$PATH"

#############################################
# TOOL INITIALIZATION
#############################################

# Starship prompt (if installed)
if command -v starship &> /dev/null; then
    eval "$(starship init $DOTFILES_SHELL)"
fi

# Zoxide (smarter cd)
if command -v zoxide &> /dev/null; then
    eval "$(zoxide init $DOTFILES_SHELL)"
fi

# Direnv (directory-specific environment variables)
if command -v direnv &> /dev/null; then
    eval "$(direnv hook $DOTFILES_SHELL)"
fi

# FZF
[ -f ~/.fzf.bash ] && source ~/.fzf.bash
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# FZF configuration
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border'
if command -v fd &> /dev/null; then
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
fi

#############################################
# HISTORY
#############################################

export HISTSIZE=50000
export HISTFILESIZE=50000
export HISTCONTROL=ignoreboth:erasedups

# Append to history, don't overwrite
shopt -s histappend 2>/dev/null

#############################################
# EDITOR
#############################################

if command -v nvim &> /dev/null; then
    export EDITOR="nvim"
    export VISUAL="nvim"
elif command -v vim &> /dev/null; then
    export EDITOR="vim"
    export VISUAL="vim"
else
    export EDITOR="nano"
    export VISUAL="nano"
fi

#############################################
# ALIASES
#############################################

[ -f ~/.aliases ] && source ~/.aliases

#############################################
# GPU / CUDA
#############################################

# Common CUDA paths (adjust if needed)
if [[ -d /usr/local/cuda ]]; then
    export CUDA_HOME=/usr/local/cuda
    export PATH=$CUDA_HOME/bin:$PATH
    export LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
fi

# Quick GPU status
alias gpus='nvidia-smi'
alias gpu-watch='watch -n 1 nvidia-smi'

#############################################
# COMPLETIONS
#############################################

# Load custom completions from dotfiles. These use the `complete` builtin, so
# they are bash-only; zsh would error on them.
if [ "$DOTFILES_SHELL" = "bash" ] && [ -d "$DOTFILES_DIR/config/completions" ]; then
    for f in "$DOTFILES_DIR/config/completions"/*.bash; do
        [ -f "$f" ] && source "$f"
    done
fi

#############################################
# LOCAL OVERRIDES
#############################################

# Source local machine-specific config if exists
[ -f ~/.bashrc_local ] && source ~/.bashrc_local
